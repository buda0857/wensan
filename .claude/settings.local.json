{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "PowerShell($env:USERPROFILE; [System.Environment]::OSVersion.VersionString; node --version; npm --version)",
      "PowerShell(winget install OpenJS.NodeJS.LTS --accept-package-agreements --accept-source-agreements)",
      "PowerShell($env:Path = [System.Environment]::GetEnvironmentVariable\\(\"Path\",\"Machine\"\\) + \";\" + [System.Environment]::GetEnvironmentVariable\\(\"Path\",\"User\"\\); claude --version; \\(Get-Command claude\\).Source)"
    ]
  }
}
